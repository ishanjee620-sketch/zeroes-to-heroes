Java Script here
Document.addEventListener("DOMContentLoaded", function () {

    function startJourney(event) {
        event.preventDefault();
        alert("Welcome to ZeroTheory 🚀\nYour journey from Zeroes to Heroes starts now.");
    }

    const button = document.querySelector(".cta a");
    if (button) {
        button.addEventListener("click", startJourney);
    }

    const heading = document.querySelector("h1");
    let changed = false;

    if (heading) {
        heading.addEventListener("click", function () {
            if (!changed) {
                heading.innerText = "From Zeroes to Heroes ⚡";
                changed = true;
            } else {
                heading.innerText = "ZeroTheory";
                changed = false;
            }
        });
    }

});
